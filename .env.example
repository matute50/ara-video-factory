# Fábrica de Videos Ara — Saladillo Vivo
# ==========================================
# Copiar a .env y completar las credenciales.

# ---- Supabase (del repo saladillo-vivo-pro) ----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- Telegram (para QC humano y alertas) ----
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ---- Google Flow ----
FLOW_SKILL_DIR=/home/matias/.hermes/skills/google-flow-skill
FLOW_PROJECT_NAME=saladillo-vivo-ara
FLOW_VIDEO_MODEL="Veo 3.1 - Lite"
FLOW_COOLDOWN_SECONDS=90
FLOW_USE_CHARACTER=false
FLOW_BASE_IMAGE_REF=
SALADILLO_PHOTO_DIR=./reference_photos/center_saladillo/

# ---- Factoría ----
POLL_INTERVAL_MINUTES=5
FACTORIA_DRY_RUN=true          # true = no gasta créditos
VMIX_EXPORT_DIR=               # opcional: ruta de red/ZeroTier para clips finales

# ---- Logging ----
LOG_LEVEL=INFO
